# Database — Railway provides DATABASE_URL automatically when you add Postgres
DATABASE_URL=postgresql://user:password@localhost:5432/vovax

# API Keys — add your own values in Railway environment variables
PIXAZO_API_KEY=
HEYGEN_API_KEY=
ELEVENLABS_API_KEY=

# Morning digest (Resend)
RESEND_API_KEY=
DIGEST_RECIPIENT_EMAIL=
# Optional: after verifying domain in Resend, set e.g. "VOVAX Digest <digest@yourdomain.com>"
# DIGEST_FROM_EMAIL=

# Server
PORT=3000
NODE_ENV=development
